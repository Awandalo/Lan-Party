# Local development only. Copy to ignored .dev.vars.dev without overwriting existing values.
# Replace all three placeholders with DIFFERENT cryptographically random 32-byte values,
# encoded as 64 lowercase hex characters. These placeholders deliberately fail closed.
REGISTRATION_MODE=local-only
AUTH_SESSION_MODE=local-only
AUTH_EMAIL_TRANSPORT=local
# A THIRD independent disposable secret protects the fictional development mailbox.
AUTH_LOCAL_MAIL_SECRET=REPLACE_WITH_THIRD_LOCAL_ONLY_64_CHARACTER_HEX_VALUE
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
PASSWORD_PEPPER=REPLACE_WITH_LOCAL_ONLY_64_CHARACTER_HEX_VALUE
AUTH_RATE_LIMIT_SECRET=REPLACE_WITH_DIFFERENT_LOCAL_ONLY_64_CHARACTER_HEX_VALUE
# Google remains off until separately configured; use a dedicated local test client.
GOOGLE_AUTH_MODE=off
GOOGLE_CLIENT_ID=fictional.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_WITH_LOCAL_TEST_CLIENT_SECRET
