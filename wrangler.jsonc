{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lan-party",
  "compatibility_date": "2026-10-11",
  // Default deployment is production; development requires --env dev.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lan-party-prod",
      "database_id": "9fbe3402-c26b-45fd-be67-71775e5e6a3e",
      "migrations_dir": "./migrations"
    }
  ],
  "env": {
    // Explicit future PROD deployment profile; both activation modes remain OFF.
    "prod": {
      "name": "lan-party",
      "define": { "__LAN_MFA_TARGET__": "\"lan-party:9fbe3402-c26b-45fd-be67-71775e5e6a3e\"" },
      "vars": {
        "AUTH_ENVIRONMENT": "prod",
        "AUTH_PUBLIC_ORIGIN": "https://www.lan-party.club",
        "AUTH_EMAIL_TRANSPORT": "resend",
        "REGISTRATION_MODE": "disabled",
        "AUTH_SESSION_MODE": "disabled"
      },
      "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api", "/api/*"] },
      "d1_databases": [{ "binding": "DB", "database_name": "lan-party-prod", "database_id": "9fbe3402-c26b-45fd-be67-71775e5e6a3e", "migrations_dir": "./migrations" }]
    },
    "dev": {
      "name": "lan-party-dev",
      // Build identity only: never a runtime activation flag. Default PROD has none.
      "define": {
        "__LAN_MFA_TARGET__": "\"lan-party-dev:a3c4cea6-ceb7-43b8-b9b7-b374726b35b4\""
      },
      // Public DEV configuration is versioned; encrypted secrets stay in Cloudflare.
      "vars": {
        "AUTH_TURNSTILE_SITE_KEY": "0x4AAAAAAFaMzRB_kUUn7MuZ"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*"]
      },
      // Bindings are not inherited; select the development database explicitly.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lan-party-dev",
          "database_id": "a3c4cea6-ceb7-43b8-b9b7-b374726b35b4",
          "migrations_dir": "./migrations"
        }
      ]
    }
  }
}
